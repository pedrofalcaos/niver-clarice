# Copie para .env e preencha (NAO comite o .env).

# Conexao do PostgreSQL.
# No Railway essa variavel e criada automaticamente ao adicionar o plugin Postgres
# (use a referencia ${{ Postgres.DATABASE_URL }}). Localmente, algo como:
DATABASE_URL=postgresql://usuario:senha@localhost:5432/clarice

# Senha do painel /admin (TROQUE por uma senha sua).
ADMIN_PASSWORD=clarice2026

# Opcional: forca SSL na conexao (true/false). Em producao ja vem ligado.
# PGSSL=true
